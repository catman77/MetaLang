import MetaLang.ConditionLogic
import MetaLang.ConstraintLogic

/-!
# Non-modularity, non-classical families and the linear case (v0.27)

The enumerative part of v0.27 that can be settled without guessing the
semantics of the v0.28 filter grammar.

* **`B3` generates a non-modular logic of conditions** (`S13`): witness
  `a = 130`, `b = 132`, `c = 131`, where `a ⊨ c` and yet
  `a ⊔ (b ⊓ c) ≠ (a ⊔ b) ⊓ c`.
* **All three non-classical families are non-distributive** (`S14`): `B3`
  (already in `ConstraintLogic.lean`), the diamond `M3` and the pentagon
  `N5`.
* **Not every source yields a non-classical logic** (`S10`): on a linear
  carrier the disjunction of conditions is plain union, no hull is needed,
  and the logic of conditions is distributive.

What is **not** settled here and why: gates `S22`, `S24`, `S25` of v0.27 and
all of v0.28 speak of a "source filter grammar". The direct attempt to
identify it with the Moore families generated by a single point of `B3` was
checked computationally and **refuted**: such families generate all 61
conditions rather than the eight-element Boolean logic the corpus describes.
So a different construction is meant — filters on the source, not on the
carrier — and its definition has to be taken from `worldmeta` of v0.28. That
was done afterwards in `SourceFilterLogic.lean`, which closes these gates.
-/

namespace MetaLang

universe u

/-! ## A linear carrier: the logic of conditions is distributive -/

/-- A condition as a subset of the carrier: it contains the top and is
closed under meets. -/
def IsMooreSet {α : Type u} [SemilatticeInf α] [OrderTop α] (F : Set α) : Prop :=
  ⊤ ∈ F ∧ ∀ a ∈ F, ∀ b ∈ F, a ⊓ b ∈ F

section Linear

variable {α : Type u} [LinearOrder α] [OrderTop α]

/-- On a linear carrier, meet-closedness is free: the meet of two points is
one of them. -/
theorem linear_isMooreSet_iff (F : Set α) : IsMooreSet F ↔ ⊤ ∈ F := by
  constructor
  · exact fun h => h.1
  · intro h
    refine ⟨h, fun a ha b hb => ?_⟩
    rcases le_total a b with hab | hab
    · rw [inf_eq_left.mpr hab]; exact ha
    · rw [inf_eq_right.mpr hab]; exact hb

/-- **On a linear carrier the disjunction of conditions is plain union (gate
`S10` of v0.27).** The hull generates no new conditions, so the logic of
conditions embeds into the Boolean algebra of subsets. -/
theorem linear_union_isMooreSet {F G : Set α}
    (hF : IsMooreSet F) (hG : IsMooreSet G) : IsMooreSet (F ∪ G) :=
  (linear_isMooreSet_iff _).mpr (Or.inl hF.1)

/-- Distributivity follows: the operations on conditions are set
intersection and union. -/
theorem linear_conditions_distributive (F G H : Set α) :
    F ∩ (G ∪ H) = (F ∩ G) ∪ (F ∩ H) :=
  Set.inter_union_distrib_left F G H

end Linear

/-! ## `B3` is non-modular -/

namespace B3

/-- **A Boolean carrier generates a non-modular logic of conditions (gate
`S13` of v0.27).** Witness: `130 ⊨ 131`, and yet the modular law fails. -/
theorem not_modular :
    isMoore 130 = true ∧ isMoore 132 = true ∧ isMoore 131 = true ∧
    entails 130 131 = true ∧
    disj 130 (conj 132 131) ≠ conj (disj 130 132) 131 := by
  refine ⟨by decide, by decide, by decide, by decide, by decide⟩

/-- The explicit form: the left side is `130`, the right side `131`. -/
theorem not_modular_explicit :
    disj 130 (conj 132 131) = 130 ∧ conj (disj 130 132) 131 = 131 := by
  refine ⟨by decide, by decide⟩

end B3

/-! ## The diamond and the pentagon -/

/-- **The diamond is non-distributive (gate `S14` of v0.27).** -/
theorem m3_not_distributive :
    M3.a ⊓ (M3.b ⊔ M3.c) ≠ (M3.a ⊓ M3.b) ⊔ (M3.a ⊓ M3.c) := by decide

/-- The pentagon `N5`: the chain `o < x < y < i` and `z`, incomparable with it. -/
inductive N5 where
  /-- The bottom element. -/
  | o
  /-- The lower point of the chain. -/
  | x
  /-- The upper point of the chain. -/
  | y
  /-- The element off the chain. -/
  | z
  /-- The top element. -/
  | i
  deriving DecidableEq, Fintype, Repr

namespace N5

/-- The order of the pentagon. -/
def leB : N5 → N5 → Bool
  | .o, _ => true
  | .x, .x => true
  | .x, .y => true
  | .x, .i => true
  | .y, .y => true
  | .y, .i => true
  | .z, .z => true
  | .z, .i => true
  | .i, .i => true
  | _, _ => false

instance : LE N5 := ⟨fun a b => leB a b = true⟩

instance decLE : DecidableRel ((· ≤ ·) : N5 → N5 → Prop) :=
  fun a b => decEq (leB a b) true

/-- The join. -/
def supN : N5 → N5 → N5
  | .o, b => b
  | a, .o => a
  | .i, _ => .i
  | _, .i => .i
  | .x, .x => .x
  | .x, .y => .y
  | .y, .x => .y
  | .y, .y => .y
  | .z, .z => .z
  | .x, .z => .i
  | .z, .x => .i
  | .y, .z => .i
  | .z, .y => .i

/-- The meet. -/
def infN : N5 → N5 → N5
  | .i, b => b
  | a, .i => a
  | .o, _ => .o
  | _, .o => .o
  | .x, .x => .x
  | .x, .y => .x
  | .y, .x => .x
  | .y, .y => .y
  | .z, .z => .z
  | .x, .z => .o
  | .z, .x => .o
  | .y, .z => .o
  | .z, .y => .o

instance : Lattice N5 where
  le_refl := by decide
  le_trans := by decide
  le_antisymm := by decide
  sup := supN
  le_sup_left := by decide
  le_sup_right := by decide
  sup_le := by decide
  inf := infN
  inf_le_left := by decide
  inf_le_right := by decide
  le_inf := by decide

/-- `z` is incomparable with the chain — the lattice really is the pentagon. -/
theorem z_incomparable : ¬ (N5.z ≤ N5.x) ∧ ¬ (N5.x ≤ N5.z) := by decide

end N5

/-- **The pentagon is non-distributive (gate `S14` of v0.27).** -/
theorem n5_not_distributive :
    N5.y ⊓ (N5.x ⊔ N5.z) ≠ (N5.y ⊓ N5.x) ⊔ (N5.y ⊓ N5.z) := by decide

/-- The pentagon is non-modular as well — that is what distinguishes it from the diamond. -/
theorem n5_not_modular :
    N5.x ≤ N5.y ∧ N5.x ⊔ (N5.z ⊓ N5.y) ≠ (N5.x ⊔ N5.z) ⊓ N5.y := by
  refine ⟨by decide, by decide⟩

end MetaLang
