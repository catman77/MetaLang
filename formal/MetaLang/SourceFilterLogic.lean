import MetaLang.FilterLogic

/-!
# The logic generated by a source filter grammar (v0.28)

Downgrade #46 is lifted. The semantics is taken from the frozen
`worldmeta/filter_admissibility.py` of v0.28, not guessed:

* a **condition** is a mask of a reflective subspace of `B3` (as in
  `ConstraintLogic.lean`);
* a **source filter grammar** is given by a list of **primitive masks**;
* the **generated logic** is the closure of the list of primitives together
  with the constants `⊥ = 128` and `⊤ = 255` under `∩` and `hull (∪)`.

Exactly four frozen families on **one and the same** carrier `B3`:

| family | primitives | size | type |
|---|---|---|---|
| `principal_boolean8` | `170, 204, 240` | 8 | Boolean |
| `chain_heyting3` | `131` | 3 | Heyting, not Boolean |
| `boolean4` | `187, 196` | 4 | Boolean |
| `nondistributive13` | `149, 187, 240` | 13 | non-distributive, non-modular, non-Heyting |

Hence the main conclusion of this version: a logic is a function of the
**carrier plus the filter grammar**, not of the carrier alone. One and the
same `B3` yields four different sizes.
-/

namespace MetaLang

namespace SourceFilter

open B3

set_option maxHeartbeats 4000000
set_option maxRecDepth 100000

/-! ## The four generated logics -/

/-- The logic of the principal grammar: primitives `170, 204, 240`. -/
def principal8 : List Nat := [128, 136, 160, 170, 192, 204, 240, 255]

/-- The logic of a single chain filter: primitive `131`. -/
def chain3 : List Nat := [128, 131, 255]

/-- The logic of two filters: primitives `187, 196`. -/
def boolean4 : List Nat := [128, 187, 196, 255]

/-- The logic of three filters: primitives `149, 187, 240`. -/
def nondistributive13 : List Nat :=
  [128, 144, 145, 149, 176, 177, 181, 187, 191, 240, 241, 245, 255]

/-- The list is closed under conjunction and disjunction of conditions. -/
def logicClosed (L : List Nat) : Bool :=
  L.all fun a => L.all fun b => L.contains (conj a b) && L.contains (disj a b)

/-- The list contains the constants and all primitives of the grammar. -/
def generatedBy (L gens : List Nat) : Bool :=
  L.contains bot && L.contains topCond && gens.all L.contains

/-- All elements really are conditions. -/
def allMoore (L : List Nat) : Bool := L.all fun m => isMoore m

/-! ### The principal grammar: a Boolean logic of eight conditions -/

theorem principal8_conditions : allMoore principal8 = true := by decide

theorem principal8_closed : logicClosed principal8 = true := by decide

theorem principal8_generated : generatedBy principal8 [170, 204, 240] = true := by decide

/-- **Eight elements (gate `S16` of v0.28).** -/
theorem principal8_size : principal8.length = 8 := by decide

/-- The logic is distributive. -/
theorem principal8_distributive :
    principal8.all (fun a => principal8.all (fun b => principal8.all (fun c =>
      conj a (disj b c) == disj (conj a b) (conj a c)))) = true := by decide

/-- **And Boolean**: every condition has exactly one complement. -/
theorem principal8_boolean :
    principal8.all (fun a =>
      (principal8.filter (fun b => conj a b == bot && disj a b == topCond)).length == 1)
      = true := by decide

/-! ### One filter: a Heyting logic of three conditions, not Boolean -/

theorem chain3_conditions : allMoore chain3 = true := by decide

theorem chain3_closed : logicClosed chain3 = true := by decide

theorem chain3_generated : generatedBy chain3 [131] = true := by decide

/-- **Three elements (gate `S17` of v0.28).** -/
theorem chain3_size : chain3.length = 3 := by decide

theorem chain3_distributive :
    chain3.all (fun a => chain3.all (fun b => chain3.all (fun c =>
      conj a (disj b c) == disj (conj a b) (conj a c)))) = true := by decide

/-- **Not Boolean**: the condition `131` has no complement. -/
theorem chain3_not_boolean :
    (chain3.filter (fun b => conj 131 b == bot && disj 131 b == topCond)).length = 0 := by
  decide

/-! ### Two filters: a Boolean logic of four conditions -/

theorem boolean4_conditions : allMoore boolean4 = true := by decide

theorem boolean4_closed : logicClosed boolean4 = true := by decide

theorem boolean4_generated : generatedBy boolean4 [187, 196] = true := by decide

/-- **Four elements (gate `S18` of v0.28).** -/
theorem boolean4_size : boolean4.length = 4 := by decide

theorem boolean4_boolean :
    boolean4.all (fun a =>
      (boolean4.filter (fun b => conj a b == bot && disj a b == topCond)).length == 1)
      = true := by decide

/-! ### Three filters: thirteen conditions, nothing classical -/

theorem nondistributive13_conditions : allMoore nondistributive13 = true := by decide

theorem nondistributive13_closed : logicClosed nondistributive13 = true := by decide

theorem nondistributive13_generated :
    generatedBy nondistributive13 [149, 187, 240] = true := by decide

/-- **Thirteen elements (gate `S19` of v0.28).** -/
theorem nondistributive13_size : nondistributive13.length = 13 := by decide

/-- Non-distributive: witness `(149, 187, 240)`. -/
theorem nondistributive13_not_distributive :
    conj 149 (disj 187 240) ≠ disj (conj 149 187) (conj 149 240) := by decide

/-- Non-modular: witness `(187, 240, 191)`, where `187 ⊨ 191`. -/
theorem nondistributive13_not_modular :
    entails 187 191 = true ∧ disj 187 (conj 240 191) ≠ conj (disj 187 240) 191 := by
  refine ⟨by decide, by decide⟩

/-- Not Heyting: the implication `149 → 145` is not single-valued. -/
theorem nondistributive13_not_heyting :
    (nondistributive13.filter (fun x =>
      entails (conj 149 x) 145 &&
        !(nondistributive13.any (fun y =>
          x != y && entails x y && entails (conj 149 y) 145)))).length = 2 := by
  decide

/-! ## A logic is a function of the carrier **and** the grammar -/

/-- **One and the same carrier `B3` yields four different logic sizes (gates
`S20`, `S22`, `S26` of v0.28).** Growing the filter grammar changes the logic
without changing the semantic space. -/
theorem four_distinct_sizes :
    chain3.length = 3 ∧ boolean4.length = 4 ∧ principal8.length = 8 ∧
    nondistributive13.length = 13 := by
  refine ⟨by decide, by decide, by decide, by decide⟩

/-- **Ignoring source admissibility strictly expands the logic (gates `S13`,
`S14` of v0.28, `S25` of v0.27).** The eight conditions of the principal
grammar form a proper part of the full envelope of 61 conditions. -/
theorem ignoring_admissibility_expands :
    principal8.all (fun m => conditions.contains m) = true ∧
    principal8.length < conditions.length := by
  refine ⟨by decide, ?_⟩
  rw [principal8_size, conditions_count]
  decide

/-! ## Admissibility, reflectivity and public utility -/

/-- The principal conditions: Moore hulls of single points of `B3`. -/
def principals : List Nat := [128, 129, 130, 132, 136, 144, 160, 192]

/-- **A conjunction of principals stays principal, while a disjunction
generates a new condition (gate `S24` of v0.27).** -/
theorem principal_conj_stays_disj_grows :
    principals.contains (conj 129 130) = true ∧
    isMoore (disj 129 130) = true ∧
    principals.contains (disj 129 130) = false := by
  refine ⟨by decide, by decide, by decide⟩

/-- **A foreign filter is reflective but not admitted by the source (gates
`S7`, `S24` of v0.28).** The mask `151` is a genuine condition, and yet it is
absent from the logic of the principal grammar. -/
theorem foreign_reflective_not_admissible :
    isMoore 151 = true ∧ principal8.contains 151 = false := by
  refine ⟨by decide, by decide⟩

/-- **Non-reflective near-misses are rejected (gate `S8` of v0.28).** The
mask `134` contains the top but is not meet-closed — it is not a condition at
all. -/
theorem nonreflective_rejected : isMoore 134 = false := by decide

/-- **Every primitive of the basis is logically essential (gate `S10` of
v0.28).** Without one of the three primitives the principal logic is poorer:
six conditions instead of eight. -/
def principal_without_240 : List Nat := [128, 136, 160, 170, 204, 255]

theorem principal_without_240_closed :
    logicClosed principal_without_240 = true := by decide

theorem primitive_is_essential :
    principal_without_240.length = 6 ∧ principal8.length = 8 ∧
    principal8.contains 240 = true ∧
    principal_without_240.contains 240 = false := by
  refine ⟨by decide, by decide, by decide, by decide⟩

/-- **Public utility cannot be a criterion of admissibility (gate `S23` of
v0.28).** The conditions `170` and `149` have the same public selectivity —
four points out of eight each — but the first belongs to the logic of the
source and the second does not. -/
theorem utility_collides :
    (List.range 8).countP (fun a => mem 170 a) =
      (List.range 8).countP (fun a => mem 149 a) ∧
    principal8.contains 170 = true ∧
    principal8.contains 149 = false := by
  refine ⟨by decide, by decide, by decide⟩

/-! ## The full envelope is generated by the principal conditions -/

/-- The principal condition of a point: the Moore hull of a one-point mask. -/
def principalOf (a : Nat) : Nat := hull (1 <<< a)

theorem principalOf_matches :
    (List.range 8).map principalOf = [129, 130, 132, 136, 144, 160, 192, 128] := by
  decide

/-- The disjunctive fold of the principal conditions lying under a mask. -/
def joinPrincipals (m : Nat) : Nat :=
  (List.range 8).foldl (fun acc a => if mem m a then disj acc (principalOf a) else acc) bot

/-- **Every condition is a disjunction of principals (gate `S14` of
v0.28).** Hence: admitting every reflective condition — that is, ignoring
source admissibility — reaches the full envelope of 61 conditions, whereas
the logic of the source contains eight. -/
theorem condition_is_join_of_principals :
    conditions.all (fun m => joinPrincipals m == m) = true := by decide

/-- The principal conditions themselves belong to the envelope. -/
theorem principals_are_conditions :
    principals.all (fun p => conditions.contains p) = true := by decide

/-- **The full envelope is generated by the principal conditions.** Together
with `ignoring_admissibility_expands` this is exactly the claim `S14` of
v0.28: a reflective basis without source certification reaches all 61
conditions, while the certified logic stays eight-element. -/
theorem full_envelope_generated :
    principals.all (fun p => conditions.contains p) = true ∧
    conditions.all (fun m => joinPrincipals m == m) = true ∧
    principal8.length < conditions.length :=
  ⟨principals_are_conditions, condition_is_join_of_principals,
    ignoring_admissibility_expands.2⟩

end SourceFilter

end MetaLang
